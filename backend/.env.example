# ==========================================================
#  NAMUNA FAYL
#  Bu faylni nusxalab, nomini `.env` ga o'zgartiring
#  va o'z ma'lumotlaringiz bilan to'ldiring:
#     cp .env.example .env
# ==========================================================

# --- Neon PostgreSQL bazasi (neon.tech dan olinadi) ---
DATABASE_URL="postgresql://foydalanuvchi:parol@host.neon.tech/neondb?sslmode=require"

# --- Telegram bot (@BotFather dan olinadi) ---
BOT_TOKEN="1234567890:AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA"

# --- Admin Panelga kirish ---
ADMIN_LOGIN="admin"
ADMIN_PASSWORD="parolni_ozgartiring"

# --- Server ---
PORT=5000

# --- Manzillar ---
# ngrok ishga tushgandan keyin MINIAPP_URL ni ngrok manziliga almashtiring
MINIAPP_URL="http://localhost:5173"
ADMIN_PANEL_URL="http://localhost:5174"

# --- Xavfsizlik ---
JWT_SECRET="uzun_va_tasodifiy_maxfiy_kalit"
ALLOW_INSECURE_AUTH="true"

# ==========================================================
#  DO'KON SOZLAMALARI
# ==========================================================
SHOP_NAME="Mening do'konim"
DELIVERY_FEE=20000
FREE_DELIVERY_FROM=500000
CURRENCY="so'm"

# ==========================================================
#  TO'LOV
# ==========================================================
CARD_NUMBER="8600 0000 0000 0000"
CARD_HOLDER="ISM FAMILIYA"

# Payme / Click — merchant kalitlarini olganingizda to'ldiring
PAYME_MERCHANT_ID=""
PAYME_KEY=""
CLICK_SERVICE_ID=""
CLICK_MERCHANT_ID=""
CLICK_SECRET_KEY=""
